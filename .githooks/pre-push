#!/bin/bash
set -euo pipefail

cargo test

# Supply-chain gate: licenses / advisories / bans / sources. Only runs where
# cargo-deny is installed, so a push from a machine without it is not blocked
# (the check still passes locally and in any environment that has the tool).
if command -v cargo-deny >/dev/null 2>&1; then
    cargo deny check
else
    echo "pre-push: cargo-deny not installed; skipping 'cargo deny check'" >&2
fi
